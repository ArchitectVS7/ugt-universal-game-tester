# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/

# Secrets (repo root .env holds ANTHROPIC_API — never commit)
.env

# UGT generated output
models/
logs/
results/

# Internal-only docs / not part of the shareable framework surface.
# The per-game integrations name upstream projects and reference upstream repos;
# the status ledger is the concrete, named counterpart to the genericized root docs.
# NOTE: these are still git-tracked from before they were ignored — to actually drop
# them from the shared repo, run `git rm -r --cached integrations Dev/STATUS.md`.
Dev/STATUS.md
integrations/

# Node (integration harnesses shell out to node). No trailing slash so this also
# catches node_modules symlinks (e.g. examples/spacerquest/node_modules).
node_modules

# Virtual environments
venv/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
